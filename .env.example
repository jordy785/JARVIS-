# ---- MetaTrader 5 credentials ----
MT5_LOGIN=0
MT5_PASSWORD=changeme
MT5_SERVER=Demo
# Path to terminal64.exe on Windows; leave empty for auto on real MT5 host.
MT5_PATH=

# ---- Macro / News calendar API ----
# Optional. If empty, the Macro/News agent uses a built-in minimal/fallback
# calendar and reports UNKNOWN risk rather than calling a paid provider.
MACRO_NEWS_API_KEY=
MACRO_NEWS_PROVIDER=  # e.g. "trading_economics" | "forex_factory" | "" (none)

# ---- Trading safety ----
# LIVE trading is DISABLED by default. Must be explicitly enabled to use MODE=LIVE.
LIVE_TRADING_ENABLED=false
# ANALYSIS | PAPER | LIVE
TRADING_MODE=ANALYSIS
# Kill-switch: if true, no order (paper or live) can be placed at all.
TRADING_KILLSWITCH=false
# If true, skip the second confirmation prompt for LIVE orders (fast execution).
FAST_CONFIRMATION=false

# ---- Paper trading ----
PAPER_INITIAL_CAPITAL=500000
PAPER_BASE_CURRENCY=XOF

# ---- Risk defaults ----
RISK_MAX_RISK_PER_TRADE_PCT=1.0
RISK_MAX_DAILY_LOSS_PCT=3.0
RISK_MAX_OPEN_POSITIONS=5
RISK_MAX_EXPOSURE_PCT=20.0

# ---- Logging ----
LOG_LEVEL=INFO
LOG_FILE=logs/jarvis.log

# ---- Memory / storage ----
MEMORY_DB=jarvis/data/memory.db
